{
  /*
   * The main tsconfig excludes `**\/*.test.ts`, so the suites were never
   * typechecked - 72 type errors had accumulated there unnoticed while
   * `npm run build` stayed green. This config typechecks them.
   *
   * `rootDir` is widened to the repo root because the base config points it at
   * `./src` for emit layout; nothing is emitted here (`noEmit`), and the shipped
   * bundle is produced by esbuild in scripts/build.mjs regardless.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": { "rootDir": ".", "noEmit": true },
  "include": ["src/**/*.ts", "types/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
